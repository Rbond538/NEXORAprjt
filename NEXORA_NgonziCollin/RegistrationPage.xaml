<Page
    x:Class="NEXORA_NgonziCollin.RegistrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NEXORA_NgonziCollin"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="Black"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Height="1008"
                Width="745">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="40">
                    <Button Content="N" FontWeight="bold" Foreground="White" 
                             FontSize="35" BorderThickness="0" Background="#f0b43c" 
                             CornerRadius="10" HorizontalAlignment="Center" Padding="20 10"/>
                    <TextBlock Text="NEXORA" Foreground="White" FontSize="30" FontWeight="bold"
                               Margin="20 5 0 0"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Height="998" Width="740" Margin="750,10,0,0" Grid.Row="0">
            <StackPanel Height="993" Margin="60 0 60 0">
                <TextBlock Text="Create account" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="Enter your details to create your customer account" FontSize="15"/>
                
                <StackPanel Orientation="Horizontal" Margin="0 30 0 20">
                    <TextBox x:Name="txtFirstName" Header="First Name" PlaceholderText="FirstName"
                             Width="300" Height="70" Padding="10 12 0 0"/>
                    <TextBox x:Name="txtLastName"  Header="Last Name" PlaceholderText="LastName"
                             Width="300" Height="70" Padding="10 12 0 0" Margin="20 0 0 0"/>
                    
                </StackPanel>
                
                <TextBox x:Name="txtPhoneNumber" Header="Phone Number" PlaceholderText="Enter phone number"
                         Height="70" Padding="10 12 0 0" Margin="0 0 0 20"/>
                <TextBox x:Name="txtEmail" Header="Email Address" PlaceholderText="Enter email address"
                         Height="70" Padding="10 12 0 0" Margin="0 0 0 20"/>

                <TextBox x:Name="txtDeliveryAddress" Header="Delivery Address" PlaceholderText="Enter delivery address"
                         Height="100" Padding="10 12 0 0" Margin="0 0 0 20" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="txtCity" Header="City" PlaceholderText="City"
                             Width="300" Height="70" Padding="10 12 0 0"/>
                    <TextBox x:Name="txtCountry"  Header="Country" Text="Uganda"
                             Width="300" Height="70" Padding="10 12 0 0" Margin="20 0 0 0"/>
                </StackPanel>

                <TextBox x:Name="txtUserName" Header="Username" PlaceholderText="Choose a username"
                         Height="70" Padding="10 12 0 0" Margin="0 20 0 20"/>

                <PasswordBox x:Name="txtPassword" Header="Password" PlaceholderText="Create a Password"
                             Height="70" Padding="10 12 0 0" Margin="0 0 0 20"/>
                
                <PasswordBox x:Name="txtConfirmPassword" Header="Confirm Password" PlaceholderText="Confirm Your Password"
                             Height="70" Padding="10 12 0 0" Margin="0 0 0 20"/>

                <Button Content="CREATE ACCOUNT" Background="#f0b43c"
                        Foreground="White"
                        FontWeight="Bold"
                        CornerRadius="5"
                        Padding="10" Click="Button_Click_1"/>
                <Button Content="BACK TO LOGIN" Background="white"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderBrush="Black"
                        BorderThickness=".5"
                        CornerRadius="5"
                        Padding="10" Click="Button_Click" Margin="0 10 0 10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
